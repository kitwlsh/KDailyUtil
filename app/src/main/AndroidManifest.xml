<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    
    <!-- 레거시 저장소(공용 Download의 이전 녹음 마이그레이션 전용, 버전 상한 적용) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!--
      참고: READ_MEDIA_IMAGES / READ_MEDIA_VIDEO / READ_MEDIA_AUDIO 권한은 제거됨.
      - 이미지: Android Photo Picker(PickVisualMedia) 사용 — 권한 불필요.
      - 오디오/파일 가져오기: 시스템 문서 피커(GetContent) 사용 — 권한 불필요.
      Google Play 사진·동영상 권한 정책 준수.
    -->

    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      Android 11+ 패키지 가시성: 자매앱 설치 감지/실행('브랜드 & 자매앱' 갤러리)용.
      자매앱 목록 자체는 원격 레지스트리(family.json)로 동적 렌더되지만, 설치 감지
      (getLaunchIntentForPackage)와 앱 직접 실행만은 원격으로 못 바꾸는 컴파일타임 선언이다.
      → 미래 자매앱 패키지를 **예약분까지 미리 선언**해 두면 그 id로 출시되는 앱은 재빌드 없이
        설치배지·직접실행까지 지원된다(표준 = doc/KLOTTO_CONNECT_HANDOFF.md §8-5).
      ⚠️ QUERY_ALL_PACKAGES는 Google Play 정책 제한이 강해 사용 금지. 예약에 없는 패키지는
        설치 감지 없이 '스토어 이동'으로 우아하게 폴백한다.
    -->
    <queries>
        <package android:name="com.kitwlshCom.klotto645" />
        <package android:name="com.kitwlshcom.kjangbu" />
        <package android:name="com.kitwlshcom.kunbok" />
        <!-- 여유 예약분: 신규 자매앱은 이 id를 우선 사용할 것 -->
        <package android:name="com.kitwlshcom.kfamily1" />
        <package android:name="com.kitwlshcom.kfamily2" />
        <package android:name="com.kitwlshcom.kfamily3" />
        <package android:name="com.kitwlshcom.kfamily4" />
        <package android:name="com.kitwlshcom.kfamily5" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App.Starting"
        android:requestLegacyExternalStorage="true">
        <receiver
            android:name=".receiver.BriefingReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.kitwlshcom.kdailyutil.ACTION_MORNING_BRIEFING" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".audio.AudioCaptureService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|mediaPlayback|microphone" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Secure file sharing via FileProvider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.kitwlshcom.kdailyutil.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>