<?xml version="1.0" encoding="utf-8"?><!--
   API 31+ 백업/단말 이전 데이터 추출 규칙.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- API 키(Gemini/DART) 등 민감 설정이 저장되는 DataStore 파일을 클라우드 백업에서 제외 -->
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <!-- 단말 이전 시에도 민감 설정 제외 -->
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
